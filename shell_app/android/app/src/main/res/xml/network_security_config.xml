<?xml version="1.0" encoding="utf-8"?>
<!--
  Release: chỉ HTTPS. HTTP thường chỉ cho phép với loopback, nơi có:
  - LocalWebServer phục vụ mini app cho WebView (127.0.0.1:41xxx),
  - OTA server dev qua `adb reverse` (localhost:8080) hoặc emulator (10.0.2.2).
  Bản debug ghi đè file này bằng src/debug/res/xml/network_security_config.xml.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
